<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.4.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Include="docs/GPose_ADOF.fx" LogicalName="GPoseADOF.Shader" />
    <EmbeddedResource Include="build/reshade-addon/adof_reshade_bridge.addon64" LogicalName="GPoseADOF.Addon" />
  </ItemGroup>
  <Target Name="CheckBundledAddon" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('build/reshade-addon/adof_reshade_bridge.addon64')"
           Text="Build the bundled native add-on with scripts/build-reshade-addon.sh before building the plugin." />
  </Target>
</Project>
